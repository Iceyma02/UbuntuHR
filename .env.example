# ZimHR — Environment Variables
# These go into Vercel Dashboard → Settings → Environment Variables

# ── Vercel Postgres (copy from Vercel dashboard after creating DB) ──
DATABASE_URL="postgres://..."
DATABASE_URL_UNPOOLED="postgres://..."

# ── Auth ──
JWT_SECRET="change-this-to-a-long-random-string-min-32-chars"

# ── Client URL (your Vercel deployment URL) ──
CLIENT_URL="https://zimhr.vercel.app"

# ── Email (optional for now) ──
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@gmail.com"
SMTP_PASS="your-gmail-app-password"
